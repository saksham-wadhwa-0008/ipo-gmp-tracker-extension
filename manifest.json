{
  "manifest_version": 3,
  "name": "IPO GMP Tracker & Advisory (IPO Watch)",
  "version": "1.0.0",
  "description": "Filter Upcoming & Open IPOs with >15% GMP on IPOWatch, view daily trends, and get cancel advisories 1 day before close.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "IPO GMP Tracker (>15%)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://ipowatch.in/ipo-grey-market-premium-latest-ipo-gmp/*",
        "*://ipowatch.in/ipo-grey-market-premium-latest-ipo-gmp"
      ],
      "js": [
        "utils/date_utils.js",
        "utils/parser.js",
        "utils/seed_data.js",
        "utils/storage.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://ipowatch.in/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "*://ipowatch.in/*"
      ]
    }
  ]
}
